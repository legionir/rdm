{
  "manifest_version": 3,
  "name": "RDM Download Helper",
  "version": "0.1.0",
  "description": "Send one link or a selected set of page links to RDM.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@legionir",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "256": "icon.png"
  }
}
