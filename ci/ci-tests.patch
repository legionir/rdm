-    if: always() && !cancelled() && (github.event_name == 'push' || github.event_name == 'workflow_dispatch') && needs.build-cli-linux.result == 'success'
+    needs: [build-cli-linux, build-cli-windows, build-gui-linux, build-gui-windows, test-linux]
+    if: always() && !cancelled() && (github.event_name == 'push' || github.event_name == 'workflow_dispatch') && needs.build-cli-linux.result == 'success' && needs.test-linux.result == 'success'
