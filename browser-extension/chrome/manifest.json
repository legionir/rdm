{
  "manifest_version": 3,
  "name": "RDM Download Helper",
  "version": "0.1.0",
  "description": "Send one link or a selected set of page links to RDM.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "256": "icon.png"
  }
}
